{
  "sourceLanguage" : "en",
  "strings" : {
    "Add your ElevenLabs API key to get started." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте API-ключ ElevenLabs, чтобы начать."
