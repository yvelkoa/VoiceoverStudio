          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте API-ключ ElevenLabs, щоб почати."
          }
        }
      }
    },
    "Apple Intelligence can't read this language yet. Suggestions work for English and several other languages." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
